# SecureScope Environment Configuration
# Copy this file to .env and customize for your environment

# =======================
# Application Settings
# =======================
APP_NAME=SecureScope
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this

# =======================
# Database Configuration
# =======================
DATABASE_URL=postgresql://secureuser:securepass@postgres:5432/securescope
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# =======================
# Redis Configuration
# =======================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=redis123

# =======================
# Celery Configuration
# =======================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# =======================
# Security Settings
# =======================
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900

# =======================
# Email Configuration
# =======================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@domain.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@securescope.com

# =======================
# Notification Settings
# =======================
# Slack
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#security-alerts

# Microsoft Teams
TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/YOUR_WEBHOOK

# PagerDuty
PAGERDUTY_ENABLED=false
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-integration-key

# =======================
# External Integrations
# =======================
# JIRA
JIRA_ENABLED=false
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=your-jira-username
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=VULN

# ServiceNow
SERVICENOW_ENABLED=false
SERVICENOW_INSTANCE=your-instance.service-now.com
SERVICENOW_USERNAME=your-servicenow-username
SERVICENOW_PASSWORD=your-servicenow-password

# Splunk
SPLUNK_ENABLED=false
SPLUNK_HOST=your-splunk-host.com
SPLUNK_PORT=8088
SPLUNK_TOKEN=your-splunk-hec-token
SPLUNK_INDEX=security

# =======================
# Cloud Storage (AWS S3)
# =======================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-west-2
S3_BUCKET_BACKUPS=securescope-backups
S3_BUCKET_REPORTS=securescope-reports

# =======================
# Monitoring & Metrics
# =======================
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=admin
METRICS_PORT=9000

# =======================
# Rate Limiting
# =======================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=150

# =======================
# Scanning Configuration
# =======================
MAX_CONCURRENT_SCANS=10
DEFAULT_SCAN_TIMEOUT=3600
MAX_SCAN_TIMEOUT=7200
RESULT_RETENTION_DAYS=90

# Tool timeouts (seconds)
SUBFINDER_TIMEOUT=300
HTTPX_TIMEOUT=10
KATANA_TIMEOUT=60
DALFOX_TIMEOUT=30

# =======================
# Enterprise Features
# =======================
MULTI_TENANT_ENABLED=true
SSO_ENABLED=false
LDAP_ENABLED=false
AUDIT_LOGGING_ENABLED=true
COMPLIANCE_REPORTS_ENABLED=true

# LDAP Configuration (if enabled)
LDAP_SERVER=ldap://your-ldap-server.com
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_BIND_DN=cn=admin,dc=company,dc=com
LDAP_BIND_PASSWORD=your-ldap-password
LDAP_USER_SEARCH_BASE=ou=users,dc=company,dc=com
LDAP_GROUP_SEARCH_BASE=ou=groups,dc=company,dc=com

# SAML SSO Configuration (if enabled)
SAML_ENTITY_ID=https://securescope.yourdomain.com
SAML_SSO_URL=https://your-idp.com/sso/saml
SAML_X509_CERT_PATH=/path/to/saml/cert.pem

# =======================
# Backup Configuration
# =======================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# =======================
# Development Settings
# =======================
# Only used in development environment
DEV_SKIP_AUTH=false
DEV_MOCK_TOOLS=false
DEV_FAST_SCANS=false

# =======================
# License Configuration
# =======================
LICENSE_KEY=your-enterprise-license-key
LICENSE_TYPE=enterprise
LICENSE_ORGANIZATION=Your Organization Name

# =======================
# Custom Branding
# =======================
BRAND_NAME=SecureScope
BRAND_LOGO_URL=https://your-domain.com/logo.png
BRAND_PRIMARY_COLOR=#2563eb
BRAND_SECONDARY_COLOR=#1e40af